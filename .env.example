# InnovateX Server Configuration — Example
# Copy this file to .env and adjust values as needed.
# NEVER commit your actual .env file to version control.

PORT=3000

# ── Local AI Provider (Optional) ───────────────────────────────
# Connect a locally/self-hosted open-source language model for Ask IX.
# Core InnovateX Intelligence Engine features work WITHOUT this configured.
#
# Supported servers:
#   - Ollama (https://ollama.ai):   http://localhost:11434
#   - LM Studio:                    http://localhost:1234
#   - Any OpenAI-compatible server: http://your-server:port
#
# LOCAL_AI_ENDPOINT=http://localhost:11434
# LOCAL_AI_MODEL=llama3
# LOCAL_AI_TIMEOUT=30000
# LOCAL_AI_MAX_CONTEXT=2048
